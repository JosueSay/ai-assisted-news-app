# Base de datos de noticias (legacy)
# ==================================
# El flujo Docker/Make actual usa .env en la raíz del repositorio.
# Este archivo queda como referencia si ejecutas módulos Python manualmente desde backend/news.

# local | atlas
NEWS_DB_MODE=local

NEWS_MONGODB_DATABASE=ai_assisted_news
NEWS_MONGODB_REQUIRED=true
NEWS_MONGODB_TIMEOUT_MS=5000

# Local manual fuera de Docker:
NEWS_MONGODB_LOCAL_URI=mongodb://localhost:27018/ai_assisted_news

# Atlas:
# NEWS_MONGODB_URI_FILE=../../keys/mongodb_uri

# Identificador público del proyecto Firebase cuyo ID token se acepta.
NEWS_FIREBASE_PROJECT_ID=
