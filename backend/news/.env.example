# Base de datos de noticias
# =========================
# La URI se almacena en keys/mongodb_uri (no versionado).
# Esta variable indica la ruta hacia ese archivo.
# NEWS_MONGODB_URI_FILE=../../keys/mongodb_uri
#
# Nombre de la base de datos.
NEWS_MONGODB_DATABASE=ai_assisted_news
# Si es true, el backend no arranca sin conexión a MongoDB.
NEWS_MONGODB_REQUIRED=true
# Timeout de selección de servidor en milisegundos.
NEWS_MONGODB_TIMEOUT_MS=5000