# Proveedor real: requiere API_GPT. Para desarrollo aislado puede usarse "stub".
CHATBOT_PROVIDER=openai
API_GPT=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=1600
OPENAI_TIMEOUT_SECONDS=30

# El archivo puede montarse como volumen y se vuelve a leer en cada turno.
CHATBOT_PROMPT_FILE=prompts/system.md
CHATBOT_PROMPT_VERSION=assistant-v1
CHATBOT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Si MONGODB_URI queda vacío, el asistente funciona sin contexto de base de datos.
MONGODB_URI=mongodb://localhost:27017/assistant
MONGODB_DATABASE=assistant
MONGODB_REQUIRED=false

# "projection" lee assistant_contexts.context; "novu" lee las colecciones del prototipo.
MONGODB_CONTEXT_MODE=projection
MONGODB_CONTEXT_COLLECTION=assistant_contexts
MONGODB_USER_ID_TYPE=string
