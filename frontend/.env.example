# Configuración pública de la app Firebase (Firebase Console → Project settings → Apps).
# Estos valores son configuración cliente, NO claves privadas.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Android usa google-services.json y el cliente OAuth Web incluido (autoDetect).
# Ya no usa EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID ni el redirect ainews://.
# Client ID OAuth iOS para el flujo existente, aún pendiente de validación iOS.
# En web se usa Firebase signInWithPopup y no se configura un client ID aquí.
#
# Requiere un build propio (APK firmado o EAS dev client); no funciona dentro
# de la app genérica Expo Go para Google nativo. Ver frontend/README.md.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# API local de noticias. En Docker Compose se define desde el .env raíz.
EXPO_PUBLIC_NEWS_API_BASE_URL=http://localhost:8020

# Chatbot de noticias (backend/assistant en modo news).
EXPO_PUBLIC_ASSISTANT_API_BASE_URL=http://localhost:8010

# Opcional para Hosting manual. El pipeline lo obtiene del APK recién terminado.
EXPO_PUBLIC_ANDROID_DOWNLOAD_URL=
