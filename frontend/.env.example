# Client IDs de OAuth 2.0 de Google Cloud Console (tipo "Android" e "iOS",
# no "Web application"). Sin configurar, la app entra en modo invitado
# automáticamente y el botón de Google queda deshabilitado.
#
# Requiere un build de desarrollo propio (EAS dev client); no funciona dentro
# de la app genérica Expo Go. Ver frontend/README.md, sección "Google Sign-In real".
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
