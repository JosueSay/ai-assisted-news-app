# Plantilla segura: este repositorio no incluye una conexión real.
# BASE DE DATOS: pega la URL de tu propio proyecto de Supabase.
EXPO_PUBLIC_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
# API KEY PÚBLICA: pega únicamente la publishable/anon key de ese proyecto.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=PEGA_AQUI_LA_PUBLISHABLE_KEY
# Nunca coloques service_role, claves secretas ni contraseñas en EXPO_PUBLIC_*.

# Déjalo en true para trabajar sin base de datos. Solo false habilita la conexión.
EXPO_PUBLIC_DEMO_MODE=true

# kiosk: tablet compartida, identifica con código + PIN.
# personal: teléfono asignado a una persona, agrega biometría del dispositivo.
EXPO_PUBLIC_ATTENDANCE_DEVICE_MODE=kiosk

# A PIN-only mark is useful for development or devices without biometrics.
# Keep false when biometric verification is mandatory.
EXPO_PUBLIC_ALLOW_PIN_FALLBACK=false

# Optional second factor for the administrator after email/password.
EXPO_PUBLIC_REQUIRE_ADMIN_BIOMETRIC=false
