# AI Assisted News App local environment
# ======================================
#
# Prefer using:
# make env-local
# make env-atlas
#
# You can also copy this file to .env at the repository root.
#
# Local mode starts MongoDB from docker-compose and does not require Atlas.
# Atlas mode skips the local MongoDB service and reads the URI from keys/mongodb_uri.

# local | atlas
NEWS_DB_MODE=local

# Required by Docker Compose to automatically include the local MongoDB service.
# For Atlas mode, leave this empty:
# COMPOSE_PROFILES=
COMPOSE_PROFILES=news-local

# Atlas mode reads the real URI from this secret file. Do not put the URI here.
# NEWS_MONGODB_URI_FILE=keys/mongodb_uri

NEWS_MONGODB_DATABASE=ai_assisted_news
NEWS_MONGODB_REQUIRED=true
NEWS_MONGODB_TIMEOUT_MS=5000

# Host port for the local news MongoDB container.
# The assistant demo MongoDB already uses 27017, so the news DB uses 27018 on the host.
NEWS_LOCAL_MONGO_PORT=27018

# Local news API consumed by the Expo frontend.
NEWS_API_PORT=8020
EXPO_PUBLIC_NEWS_API_BASE_URL=http://localhost:8020

# Firebase project ID (no secreto). Lo usan la API y el chat para validar ID tokens.
NEWS_FIREBASE_PROJECT_ID=

# Chatbot de noticias: backend/assistant en modo news (servicio chatbot, puerto 8010).
# stub: responde solo con datos de MongoDB, sin costo de IA.
# openai: responde con IA; requiere keys/openai_api_key y los precios de abajo.
# Seleccionar después de env-local/env-atlas: make chatbot-stub o make chatbot-api
# Aplicar al servicio con: make chatbot-up
CHATBOT_PROVIDER=stub
# CHATBOT_PROMPT_VERSION=news-v3
CHAT_SESSION_TTL_SECONDS=3600
EXPO_PUBLIC_ASSISTANT_API_BASE_URL=http://localhost:8010
# OPENAI_MODEL=gpt-5-mini
# Precio del modelo en USD por millón de tokens; obligatorios con CHATBOT_PROVIDER=openai.
# Copiarlos de la página de precios del proveedor para el modelo elegido.
# NEWS_CHAT_INPUT_USD_PER_MILLION=
# NEWS_CHAT_OUTPUT_USD_PER_MILLION=
# NEWS_AI_BUDGET_USD=20
# Ubicación simulada inicial (countryCode del catálogo) para usuarios nuevos del chat.
# NEWS_CHAT_DEFAULT_LOCATION_CODE=GT
